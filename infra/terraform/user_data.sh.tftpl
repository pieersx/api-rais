#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y curl git nginx rsync mysql-client unzip ca-certificates

curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
apt-get install -y nodejs

corepack enable
corepack prepare pnpm@10.27.0 --activate

mkdir -p /opt/rais-api/current
chown -R ubuntu:ubuntu /opt/rais-api

cat >/etc/nginx/sites-available/rais-api <<'NGINXEOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}
NGINXEOF

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/rais-api /etc/nginx/sites-enabled/rais-api
nginx -t
systemctl enable nginx
systemctl restart nginx
